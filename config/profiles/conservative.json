{
  "profile_name": "Conservative Wealth Preservation",
  "target_annual_return": "4% - 6%",
  "max_drawdown_limit": "3%",
  "asset_allocation": {
    "forex_majors": 0.50,
    "gold_commodities": 0.30,
    "index_cfds": 0.15,
    "crypto_bluechips": 0.05
  },
  "rebalancing": {
    "enabled": true,
    "threshold_pct": 2.0,
    "frequency": "weekly"
  },
  "risk_management": {
    "path_simulation_runs": 10000,
    "confidence_level": 0.95,
    "stress_test_scenarios": ["2008_financial_crisis", "covid_crash"],
    "dynamic_position_sizing": true,
    "max_position_size_pct": 0.10,
    "volatility_target": 0.05
  },
  "strategy_nodes": {
    "version": "1.0",
    "nodes": [
      {
        "id": "eurusd_data",
        "type": "DataSourceNode",
        "params": {"symbol": "EURUSD", "timeframe": "4h"},
        "position": {"x": 100, "y": 100}
      },
      {
        "id": "gold_data",
        "type": "DataSourceNode", 
        "params": {"symbol": "XAUUSD", "timeframe": "4h"},
        "position": {"x": 100, "y": 200}
      },
      {
        "id": "sma_50",
        "type": "IndicatorNode",
        "params": {"indicator": "SMA", "period": 50},
        "position": {"x": 300, "y": 100}
      },
      {
        "id": "sma_200",
        "type": "IndicatorNode",
        "params": {"indicator": "SMA", "period": 200},
        "position": {"x": 300, "y": 200}
      },
      {
        "id": "trend_filter",
        "type": "ConditionNode",
        "params": {"condition": "cross_above"},
        "position": {"x": 500, "y": 150}
      },
      {
        "id": "risk_check",
        "type": "RiskNode",
        "params": {"max_position_pct": 0.05},
        "position": {"x": 700, "y": 150}
      },
      {
        "id": "long_entry",
        "type": "ActionNode",
        "params": {"action": "buy", "size_pct": 0.03},
        "position": {"x": 900, "y": 150}
      }
    ],
    "connections": [
      {"from": "eurusd_data", "to": "sma_50"},
      {"from": "eurusd_data", "to": "sma_200"},
      {"from": "sma_50", "to": "trend_filter"},
      {"from": "sma_200", "to": "trend_filter"},
      {"from": "trend_filter", "to": "risk_check"},
      {"from": "risk_check", "to": "long_entry"}
    ]
  }
}
