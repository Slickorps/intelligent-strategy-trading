{
  "profile_name": "Balanced Growth Strategy",
  "target_annual_return": "8% - 12%",
  "max_drawdown_limit": "8%",
  "asset_allocation": {
    "forex_majors": 0.40,
    "gold_commodities": 0.20,
    "index_cfds": 0.30,
    "crypto_bluechips": 0.10
  },
  "rebalancing": {
    "enabled": true,
    "threshold_pct": 3.0,
    "frequency": "daily"
  },
  "risk_management": {
    "path_simulation_runs": 10000,
    "confidence_level": 0.95,
    "stress_test_scenarios": ["2008_financial_crisis", "covid_crash", "taper_tantrum"],
    "dynamic_position_sizing": true,
    "max_position_size_pct": 0.15,
    "volatility_target": 0.10
  },
  "strategy_nodes": {
    "version": "1.0",
    "nodes": [
      {
        "id": "multi_asset_data",
        "type": "DataSourceNode",
        "params": {"symbols": ["EURUSD", "GBPUSD", "XAUUSD", "SPX500"], "timeframe": "1h"},
        "position": {"x": 100, "y": 100}
      },
      {
        "id": "momentum_indicator",
        "type": "IndicatorNode",
        "params": {"indicator": "Momentum", "period": 14},
        "position": {"x": 300, "y": 50}
      },
      {
        "id": "rsi_indicator",
        "type": "IndicatorNode",
        "params": {"indicator": "RSI", "period": 14},
        "position": {"x": 300, "y": 150}
      },
      {
        "id": "volatility_filter",
        "type": "IndicatorNode",
        "params": {"indicator": "ATR", "period": 14},
        "position": {"x": 300, "y": 250}
      },
      {
        "id": "entry_condition",
        "type": "ConditionNode",
        "params": {"condition": "momentum_above_threshold", "threshold": 50},
        "position": {"x": 500, "y": 100}
      },
      {
        "id": "risk_manager",
        "type": "RiskNode",
        "params": {
          "max_position_pct": 0.10,
          "volatility_adjustment": true
        },
        "position": {"x": 700, "y": 100}
      },
      {
        "id": "portfolio_action",
        "type": "ActionNode",
        "params": {"action": "rebalance", "target_weights": "from_config"},
        "position": {"x": 900, "y": 100}
      }
    ],
    "connections": [
      {"from": "multi_asset_data", "to": "momentum_indicator"},
      {"from": "multi_asset_data", "to": "rsi_indicator"},
      {"from": "multi_asset_data", "to": "volatility_filter"},
      {"from": "momentum_indicator", "to": "entry_condition"},
      {"from": "rsi_indicator", "to": "entry_condition"},
      {"from": "entry_condition", "to": "risk_manager"},
      {"from": "risk_manager", "to": "portfolio_action"}
    ]
  }
}
