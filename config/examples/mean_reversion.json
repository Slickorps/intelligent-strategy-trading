{
  "profile_name": "Mean Reversion Strategy",
  "target_annual_return": "8% - 14%",
  "max_drawdown_limit": "6%",
  "asset_allocation": {
    "forex_majors": 0.45,
    "gold_commodities": 0.10,
    "index_cfds": 0.35,
    "crypto_bluechips": 0.10
  },
  "rebalancing": {
    "enabled": true,
    "threshold_pct": 4.0,
    "frequency": "daily"
  },
  "risk_management": {
    "path_simulation_runs": 10000,
    "confidence_level": 0.95,
    "stress_test_scenarios": ["2008_financial_crisis", "covid_crash", "flash_crash_2010"],
    "dynamic_position_sizing": true,
    "max_position_size_pct": 0.15,
    "volatility_target": 0.08,
    "mean_reversion_entry_zscore": 2.0,
    "mean_reversion_exit_zscore": 0.5
  },
  "strategy_nodes": {
    "version": "1.0",
    "description": "Bollinger Bands mean reversion with RSI confirmation",
    "nodes": [
      {
        "id": "data_eurusd",
        "type": "DataSourceNode",
        "params": {"symbol": "EURUSD", "timeframe": "30m"},
        "position": {"x": 50, "y": 100}
      },
      {
        "id": "bollinger",
        "type": "IndicatorNode",
        "params": {"indicator": "BollingerBands", "period": 20, "std_dev": 2.0},
        "position": {"x": 280, "y": 100}
      },
      {
        "id": "rsi",
        "type": "IndicatorNode",
        "params": {"indicator": "RSI", "period": 14},
        "position": {"x": 280, "y": 250}
      },
      {
        "id": "oversold",
        "type": "ConditionNode",
        "params": {"condition": "less_than", "input_a": "close", "input_b": "lower_band"},
        "position": {"x": 500, "y": 100}
      },
      {
        "id": "overbought",
        "type": "ConditionNode",
        "params": {"condition": "greater_than", "input_a": "close", "input_b": "upper_band"},
        "position": {"x": 500, "y": 200}
      },
      {
        "id": "rsi_oversold",
        "type": "ConditionNode",
        "params": {"condition": "less_than", "input_a": "rsi", "input_b": 30},
        "position": {"x": 500, "y": 300}
      },
      {
        "id": "risk_mgmt",
        "type": "RiskNode",
        "params": {"method": "fixed_percentage", "risk_per_trade_pct": 0.5},
        "position": {"x": 700, "y": 200}
      },
      {
        "id": "buy_long",
        "type": "ActionNode",
        "params": {"action": "buy", "order_type": "limit", "size_pct": 0.10},
        "position": {"x": 900, "y": 100}
      },
      {
        "id": "sell_short",
        "type": "ActionNode",
        "params": {"action": "sell", "order_type": "limit", "size_pct": 0.10},
        "position": {"x": 900, "y": 300}
      }
    ],
    "connections": [
      {"from": "data_eurusd", "to": "bollinger"},
      {"from": "data_eurusd", "to": "rsi"},
      {"from": "bollinger", "to": "oversold"},
      {"from": "bollinger", "to": "overbought"},
      {"from": "rsi", "to": "rsi_oversold"},
      {"from": "oversold", "to": "risk_mgmt"},
      {"from": "rsi_oversold", "to": "risk_mgmt"},
      {"from": "overbought", "to": "risk_mgmt"},
      {"from": "risk_mgmt", "to": "buy_long"},
      {"from": "risk_mgmt", "to": "sell_short"}
    ]
  }
}