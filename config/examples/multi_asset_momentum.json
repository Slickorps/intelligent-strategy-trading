{
  "profile_name": "Multi-Asset Momentum Strategy",
  "target_annual_return": "15% - 25%",
  "max_drawdown_limit": "12%",
  "asset_allocation": {
    "forex_majors": 0.25,
    "gold_commodities": 0.20,
    "index_cfds": 0.35,
    "crypto_bluechips": 0.20
  },
  "rebalancing": {
    "enabled": true,
    "threshold_pct": 6.0,
    "frequency": "weekly"
  },
  "risk_management": {
    "path_simulation_runs": 10000,
    "confidence_level": 0.95,
    "stress_test_scenarios": ["2008_financial_crisis", "covid_crash", "crypto_winter_2022"],
    "dynamic_position_sizing": true,
    "max_position_size_pct": 0.25,
    "volatility_target": 0.15,
    "momentum_lookback_periods": [3, 6, 12],
    "top_asset_count": 3
  },
  "strategy_nodes": {
    "version": "1.0",
    "description": "Cross-asset momentum ranking with dynamic allocation to top performers",
    "nodes": [
      {
        "id": "data_all",
        "type": "DataSourceNode",
        "params": {"symbols": ["EURUSD", "GBPUSD", "XAUUSD", "SPX500", "BTCUSD", "ETHUSD"], "timeframe": "1d"},
        "position": {"x": 50, "y": 100}
      },
      {
        "id": "momentum_3m",
        "type": "IndicatorNode",
        "params": {"indicator": "Momentum", "period": 63, "source": "close"},
        "position": {"x": 280, "y": 50}
      },
      {
        "id": "momentum_6m",
        "type": "IndicatorNode",
        "params": {"indicator": "Momentum", "period": 126, "source": "close"},
        "position": {"x": 280, "y": 150}
      },
      {
        "id": "momentum_12m",
        "type": "IndicatorNode",
        "params": {"indicator": "Momentum", "period": 252, "source": "close"},
        "position": {"x": 280, "y": 250}
      },
      {
        "id": "rank_assets",
        "type": "ConditionNode",
        "params": {"condition": "rank_by_composite_momentum", "weights": {"3m": 0.3, "6m": 0.4, "12m": 0.3}},
        "position": {"x": 500, "y": 150}
      },
      {
        "id": "volatility_filter",
        "type": "RiskNode",
        "params": {"method": "volatility_regime_filter", "max_atr_pct": 0.05},
        "position": {"x": 700, "y": 100}
      },
      {
        "id": "allocate_top",
        "type": "ActionNode",
        "params": {"action": "rebalance_portfolio", "method": "equal_weight_top_n", "top_n": 3},
        "position": {"x": 900, "y": 150}
      },
      {
        "id": "exit_bottom",
        "type": "ActionNode",
        "params": {"action": "sell", "method": "exit_bottom_performers", "bottom_n": 1},
        "position": {"x": 900, "y": 280}
      }
    ],
    "connections": [
      {"from": "data_all", "to": "momentum_3m"},
      {"from": "data_all", "to": "momentum_6m"},
      {"from": "data_all", "to": "momentum_12m"},
      {"from": "momentum_3m", "to": "rank_assets"},
      {"from": "momentum_6m", "to": "rank_assets"},
      {"from": "momentum_12m", "to": "rank_assets"},
      {"from": "rank_assets", "to": "volatility_filter"},
      {"from": "volatility_filter", "to": "allocate_top"},
      {"from": "volatility_filter", "to": "exit_bottom"}
    ]
  }
}