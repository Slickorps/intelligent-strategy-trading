{
  "profile_name": "Breakout Trading Strategy",
  "target_annual_return": "15% - 22%",
  "max_drawdown_limit": "10%",
  "asset_allocation": {
    "forex_majors": 0.30,
    "gold_commodities": 0.20,
    "index_cfds": 0.35,
    "crypto_bluechips": 0.15
  },
  "rebalancing": {
    "enabled": false,
    "threshold_pct": 5.0,
    "frequency": "monthly"
  },
  "risk_management": {
    "path_simulation_runs": 10000,
    "confidence_level": 0.95,
    "stress_test_scenarios": ["2008_financial_crisis", "covid_crash", "flash_crash_2010"],
    "dynamic_position_sizing": true,
    "max_position_size_pct": 0.20,
    "volatility_target": 0.14,
    "breakout_confirmation_volume": true,
    "breakout_lookback_periods": [20, 50],
    "use_fibonacci_targets": true
  },
  "strategy_nodes": {
    "version": "1.0",
    "description": "Channel breakout strategy with volume confirmation and Fibonacci profit targets",
    "nodes": [
      {
        "id": "data_xau",
        "type": "DataSourceNode",
        "params": {"symbol": "XAUUSD", "timeframe": "1h"},
        "position": {"x": 50, "y": 100}
      },
      {
        "id": "data_spx",
        "type": "DataSourceNode",
        "params": {"symbol": "SPX500", "timeframe": "1h"},
        "position": {"x": 50, "y": 200}
      },
      {
        "id": "high_20",
        "type": "IndicatorNode",
        "params": {"indicator": "Momentum", "period": 20, "source": "high", "mode": "rolling_max"},
        "position": {"x": 280, "y": 50}
      },
      {
        "id": "low_20",
        "type": "IndicatorNode",
        "params": {"indicator": "Momentum", "period": 20, "source": "low", "mode": "rolling_min"},
        "position": {"x": 280, "y": 130}
      },
      {
        "id": "atr_breakout",
        "type": "IndicatorNode",
        "params": {"indicator": "ATR", "period": 14},
        "position": {"x": 280, "y": 210}
      },
      {
        "id": "volume_sma",
        "type": "IndicatorNode",
        "params": {"indicator": "SMA", "period": 20, "source": "volume"},
        "position": {"x": 280, "y": 290}
      },
      {
        "id": "breakout_up",
        "type": "ConditionNode",
        "params": {"condition": "greater_than", "input_a": "close", "input_b": "high_20"},
        "position": {"x": 500, "y": 80}
      },
      {
        "id": "breakout_down",
        "type": "ConditionNode",
        "params": {"condition": "less_than", "input_a": "close", "input_b": "low_20"},
        "position": {"x": 500, "y": 180}
      },
      {
        "id": "volume_confirmation",
        "type": "ConditionNode",
        "params": {"condition": "greater_than", "input_a": "volume", "input_b": "volume_sma", "multiplier": 1.5},
        "position": {"x": 500, "y": 280}
      },
      {
        "id": "risk_breakout",
        "type": "RiskNode",
        "params": {"method": "atr_stop", "atr_multiple": 2.0, "use_fib_targets": true, "fib_levels": [1.272, 1.618, 2.618]},
        "position": {"x": 700, "y": 180}
      },
      {
        "id": "buy_breakout",
        "type": "ActionNode",
        "params": {"action": "buy", "order_type": "market", "size_pct": 0.12},
        "position": {"x": 900, "y": 80}
      },
      {
        "id": "sell_breakout",
        "type": "ActionNode",
        "params": {"action": "sell", "order_type": "market", "size_pct": 0.12},
        "position": {"x": 900, "y": 280}
      },
      {
        "id": "take_profit_1",
        "type": "ActionNode",
        "params": {"action": "take_profit", "level": "fib_1.272", "size_pct": 0.33},
        "position": {"x": 900, "y": 400}
      },
      {
        "id": "take_profit_2",
        "type": "ActionNode",
        "params": {"action": "take_profit", "level": "fib_1.618", "size_pct": 0.33},
        "position": {"x": 900, "y": 480}
      }
    ],
    "connections": [
      {"from": "data_xau", "to": "high_20"},
      {"from": "data_xau", "to": "low_20"},
      {"from": "data_xau", "to": "atr_breakout"},
      {"from": "data_xau", "to": "volume_sma"},
      {"from": "high_20", "to": "breakout_up"},
      {"from": "low_20", "to": "breakout_down"},
      {"from": "breakout_up", "to": "volume_confirmation"},
      {"from": "breakout_down", "to": "volume_confirmation"},
      {"from": "volume_sma", "to": "volume_confirmation"},
      {"from": "volume_confirmation", "to": "risk_breakout"},
      {"from": "atr_breakout", "to": "risk_breakout"},
      {"from": "risk_breakout", "to": "buy_breakout"},
      {"from": "risk_breakout", "to": "sell_breakout"},
      {"from": "risk_breakout", "to": "take_profit_1"},
      {"from": "risk_breakout", "to": "take_profit_2"}
    ]
  }
}