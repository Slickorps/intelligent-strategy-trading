{
  "profile_name": "Trend Following Strategy",
  "target_annual_return": "12% - 18%",
  "max_drawdown_limit": "8%",
  "asset_allocation": {
    "forex_majors": 0.35,
    "gold_commodities": 0.15,
    "index_cfds": 0.40,
    "crypto_bluechips": 0.10
  },
  "rebalancing": {
    "enabled": true,
    "threshold_pct": 5.0,
    "frequency": "weekly"
  },
  "risk_management": {
    "path_simulation_runs": 10000,
    "confidence_level": 0.95,
    "stress_test_scenarios": ["2008_financial_crisis", "covid_crash", "rate_hike_2022"],
    "dynamic_position_sizing": true,
    "max_position_size_pct": 0.20,
    "volatility_target": 0.12,
    "stop_loss_atr_multiple": 2.0
  },
  "strategy_nodes": {
    "version": "1.0",
    "description": "Dual moving average trend following with ATR-based position sizing",
    "nodes": [
      {
        "id": "data_eurusd",
        "type": "DataSourceNode",
        "params": {"symbol": "EURUSD", "timeframe": "1h"},
        "position": {"x": 50, "y": 100}
      },
      {
        "id": "data_spx",
        "type": "DataSourceNode",
        "params": {"symbol": "SPX500", "timeframe": "1h"},
        "position": {"x": 50, "y": 250}
      },
      {
        "id": "ema_fast",
        "type": "IndicatorNode",
        "params": {"indicator": "EMA", "period": 20, "source": "close"},
        "position": {"x": 280, "y": 100}
      },
      {
        "id": "ema_slow",
        "type": "IndicatorNode",
        "params": {"indicator": "EMA", "period": 50, "source": "close"},
        "position": {"x": 280, "y": 200}
      },
      {
        "id": "atr",
        "type": "IndicatorNode",
        "params": {"indicator": "ATR", "period": 14},
        "position": {"x": 480, "y": 100}
      },
      {
        "id": "trend_up",
        "type": "ConditionNode",
        "params": {"condition": "greater_than", "input_a": "ema_fast", "input_b": "ema_slow"},
        "position": {"x": 500, "y": 250}
      },
      {
        "id": "risk_sizing",
        "type": "RiskNode",
        "params": {"method": "atr_percentage", "risk_per_trade_pct": 1.0},
        "position": {"x": 700, "y": 175}
      },
      {
        "id": "buy_signal",
        "type": "ActionNode",
        "params": {"action": "buy", "size_source": "atr"},
        "position": {"x": 900, "y": 100}
      },
      {
        "id": "sell_signal",
        "type": "ActionNode",
        "params": {"action": "sell", "size_source": "atr"},
        "position": {"x": 900, "y": 250}
      }
    ],
    "connections": [
      {"from": "data_eurusd", "to": "ema_fast"},
      {"from": "data_eurusd", "to": "ema_slow"},
      {"from": "data_eurusd", "to": "atr"},
      {"from": "ema_fast", "to": "trend_up"},
      {"from": "ema_slow", "to": "trend_up"},
      {"from": "atr", "to": "risk_sizing"},
      {"from": "trend_up", "to": "risk_sizing"},
      {"from": "risk_sizing", "to": "buy_signal"},
      {"from": "risk_sizing", "to": "sell_signal"}
    ]
  }
}