# Intelligent Strategy Trading Environment Configuration
#
# Copy to .env and adjust. All variables map to Settings fields in
# src/ist/core/config.py unless commented as broker/monitoring-specific.

# Application
APP_NAME=intelligent-strategy-trading
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# API Security
# Comma-separated list of allowed CORS origins (defaults to localhost).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# When set, all non-exempt routes require this key via the "X-API-Key"
# header or "Authorization: Bearer <key>". Leave empty to disable auth.
# API_KEY=

# Data
DATA_PATH=./data
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# Database (optional)
# DATABASE_URL=postgresql://user:pass@localhost/ist

# Redis (optional, for production caching)
# REDIS_URL=redis://localhost:6379/0

# Risk Management Defaults
DEFAULT_SIMULATION_RUNS=10000
DEFAULT_CONFIDENCE_LEVEL=0.95
MAX_DRAWDOWN_DEFAULT_LIMIT=0.05

# Backtest Defaults
DEFAULT_INITIAL_CAPITAL=100000.0
DEFAULT_COMMISSION_RATE=0.001

# ---------------------------------------------------------------------------
# Broker Configuration (optional, consumed by broker adapters)
# Interactive Brokers (TWS / IB Gateway)
# IB_HOST=127.0.0.1
# IB_PORT=7497
# IB_CLIENT_ID=1

# OANDA (practice = demo environment)
# OANDA_ACCESS_TOKEN=
# OANDA_ACCOUNT_ID=
# OANDA_PRACTICE=true

# Alpaca (paper = simulated trading)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Monitoring (Prometheus / Grafana)
# Exposed automatically on the /metrics endpoint of the API server.
# LOG_FORMAT=json  # structured logs for metric ingestion
# ---------------------------------------------------------------------------
